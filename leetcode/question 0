class Solution {
public:
    bool isReverse(int x){
        int num =x;
        long reverse=0;
        while(x>0){
            int digit=x%10;
            reverse= reverse*10+digit;
            if(reverse > INT_MAX || reverse< INT_MIN){
                return false;
            }
            x=x/10;
        }
        if(num == reverse){
            return true;
        }
        return false;
    }

    bool isPalindrome(int x) {
        if(x< 0){
            return false;
        }
        bool result= isReverse(x);
        return result;
    }
};